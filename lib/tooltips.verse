BoundsTooltip<internal><localizes> : message = "The object space bounds of the entity."
CacheTooltip<internal><localizes> : message = "If true, the default bounds will be ignored and the encapsulation of the bounds of the entity's immediate children will be cached."
CenterTooltip<internal><localizes> : message = "The midpoint of the bounding box."
DebugDrawTooltip<internal><localizes> : message = "Whether the bounds should automatically be debug drawn."
DistanceTooltip<internal><localizes> : message = "The distance measured from the plane to the origin along `Normal`."
ExtentsTooltip<internal><localizes> : message = "The extents along each axis, half of the size of the bounding box. Appropriate values for a mesh can be found in the Viewport Panel of the Static Mesh Editor under \"Approx. Size\"."
HeightTooltip<internal><localizes> : message = "The height of the rectangle, measured from the Y position."
NormalTooltip<internal><localizes> : message = "The normal vector of the plane."
OrientationTooltip<internal><localizes> : message = "The orientation of the bounding box."
OrientedExtentsTooltip<internal><localizes> : message = "The extents along each axis, half of the size of the bounding box."
OriginTooltip<internal><localizes> : message = "The origin of the ray."
RayTooltip<internal><localizes> : message = "The direction of the ray."
XTooltip<internal><localizes> : message = "The X coordinate of the rectangle."
YTooltip<internal><localizes> : message = "The Y coordinate of the rectangle."
WidthTooltip<internal><localizes> : message = "The width of the rectangle, measured from the X position."